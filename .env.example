# fnmusic_bridge 部署配置（复制为 .env 后修改）
# install.sh 会自动生成 .env 并填入随机管理员密码。

FNMUSIC_PORT=8600
FNMUSIC_DATA_DIR=./data
TZ=Asia/Shanghai

# 必填：管理员密码，至少 8 位
BRIDGE_ADMIN_PASSWORD=

# 飞牛音乐 API 的 unix socket（fnOS 默认路径）
FNMUSIC_SOCKET_PATH=/run/trim_music.socket

# 飞牛音乐数据库目录（只读，用于自动读取账户 token）
FNMUSIC_FNDB_DIR=/usr/local/apps/@appdata/trim.music/db

# 镜像地址；固定版本更利于回滚
# 音乐页代理上游：默认走 socket；也可填 host:port
FNMUSIC_MUSIC_UPSTREAM=unix:/run/trim_music.socket

FNMUSIC_IMAGE=laobaiart/fnmusic-bridge:1.24.3
